  "js": "doc.select('div').hasClass('b')"},
 {"name": "Elements.hasClass: none has it",
  "html": "<div class='a b'>x</div><div class='c'>y</div>",
  "js": "doc.select('div').hasClass('d')"},
 {"name": "Elements.hasClass: empty selection",
  "html": "<div class='a'>x</div>",
  "js": "doc.select('span').hasClass('a')"},
 {"name": "Elements.hasClass: case-insensitive",
  "html": "<div class='Active'>x</div>",
  "js": "doc.select('div').hasClass('active')"},
 {"name": "Element.hasClass: case-insensitive",
  "html": "<div class='Active'>x</div>",
  "js": "doc.selectFirst('div').hasClass('ACTIVE')"},
 {"name": "Element.hasClass: tab and newline separate classes",
  "html": "<div class='a\tb\nc'>x</div>",
  "js": "doc.selectFirst('div').hasClass('b') + ',' + doc.selectFirst('div').hasClass('c')"},
