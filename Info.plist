<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GitCommitSHA</key>
	<string>$(GIT_COMMIT_SHA)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hant</string>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.540650701012-8q81u29qbeodaa4gmr0sui7rg1gnivhb</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.yuedu.booksource.import</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yuedu</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.legado.booksource.import</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>legado</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>540650701012-8q81u29qbeodaa4gmr0sui7rg1gnivhb.apps.googleusercontent.com</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Book sources are user-configured third-party servers, many HTTP-only.
		     NSAllowsLocalNetworking is intentionally omitted: on iOS 10+ any granular
		     ATS key makes the system ignore NSAllowsArbitraryLoads, which would re-block
		     public HTTP. Arbitrary loads already covers local networking too. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- The offline-download Live Activity (Dynamic Island + Lock Screen). Updates are
	     pushed by the app process only; there is no ActivityKit push token and no
	     aps-environment entitlement, so progress holds at its last value while the app is
	     suspended and catches up when it runs again. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Shows the app's Documents directory under "On My iPhone" in the Files app, so
	     users can get at the books they imported (and back them up or copy them off).
	     Documents therefore holds ONLY user-owned files — book files, imported fonts,
	     tab icons. App-internal data (the books_meta.json shelf index, covers, caches)
	     lives under Application Support; see AppStorage and AppStorageMigration. Do not
	     write app-internal files to Documents while this key is set: deleting
	     books_meta.json by hand empties the user's shelf. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UIPrefersShowingLanguageSettings</key>
	<true/>
	<!-- App-owned file types. A UTType(exportedAs:) in Swift only names its identifier;
	     every concrete type also needs a matching declaration here or it remains
	     provisional and ShareLink/fileImporter behavior degrades. Keep each identifier,
	     conformance, and extension in sync with its UTType extension. The log type uses
	     public.data rather than public.text so chat apps receive a file attachment. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.yuedu.reader-style</string>
			<key>UTTypeDescription</key>
			<string>Yuedu Reader Style</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>yuedustyle</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.yuedu.log-file</string>
			<key>UTTypeDescription</key>
			<string>Yuedu Log File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>txt</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
