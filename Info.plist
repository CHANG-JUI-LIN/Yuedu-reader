<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hant</string>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.540650701012-8q81u29qbeodaa4gmr0sui7rg1gnivhb</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.yuedu.booksource.import</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yuedu</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.legado.booksource.import</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>legado</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>540650701012-8q81u29qbeodaa4gmr0sui7rg1gnivhb.apps.googleusercontent.com</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Book sources are user-configured third-party servers, many HTTP-only.
		     NSAllowsLocalNetworking is intentionally omitted: on iOS 10+ any granular
		     ATS key makes the system ignore NSAllowsArbitraryLoads, which would re-block
		     public HTTP. Arbitrary loads already covers local networking too. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Shows the app's Documents directory under "On My iPhone" in the Files app, so
	     users can get at the books they imported (and back them up or copy them off).
	     Documents therefore holds ONLY user-owned files — book files, imported fonts,
	     tab icons. App-internal data (the books_meta.json shelf index, covers, caches)
	     lives under Application Support; see AppStorage and AppStorageMigration. Do not
	     write app-internal files to Documents while this key is set: deleting
	     books_meta.json by hand empties the user's shelf. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UIPrefersShowingLanguageSettings</key>
	<true/>
</dict>
</plist>
