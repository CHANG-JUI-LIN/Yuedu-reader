rules_version = '2';

// Assumed data model:
// - users/{uid}: private profile and reader preferences owned by uid.
// - users/{uid}/{collection}/{docId}: private sync records owned by uid.
// - entitlements/{uid}: server-aggregated membership status; owner-readable only.
// - accountTokens/{uid}: server-owned UUID used as StoreKit appAccountToken.
// - purchaseBindings/{originalTransactionId}: server-verified Apple transaction owner.
// - testflightRequests/{email}: server-owned normalized TestFlight request.
// - testflightProRequests/{uid}: server-owned one-time TestFlight slot per Pro account.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Aggregated membership is written only by Cloud Functions with Admin SDK.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // These collections contain server-owned purchase identity and transaction data.
    match /accountTokens/{uid} {
      allow read, write: if false;
    }

    match /purchaseBindings/{originalTransactionId} {
      allow read, write: if false;
    }

    // TestFlight access requests are written only by Cloud Functions with
    // Admin SDK (email validation + idempotency live in the function).
    match /testflightRequests/{email} {
      allow read, write: if false;
    }

    // One server-owned TestFlight slot per authenticated Pro account. The
    // callable owns this collection so clients cannot reset the one-time gate.
    match /testflightProRequests/{uid} {
      allow read, write: if false;
    }

    // Client-side entitlement diagnostics, auto-reported by the app the moment
    // a Pro entitlement drops (true -> false) on a device the developer cannot
    // reach directly (e.g. a user reporting from behind a VPN). Anonymous
    // create with a whitelisted schema of non-sensitive fields only; the
    // developer reads these from the Firebase console with admin credentials.
    match /entitlementDiagnostics/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
        "storeKit", "account", "iCloud", "ownedProducts", "revokedCount", "uid",
        "appVersion", "build", "storefront", "iCloudAccountStatus", "createdAt"
      ]);
      allow read, update, delete: if false;
    }

    // Diagnostic logs a user chooses to send from 設定 → 回饋中心
    // (`DiagnosticReportUploader`). Anonymous create-only, whitelisted fields, bounded
    // sizes; the document id is the report number the user quotes. Nothing is readable
    // from a client — the developer reads them with admin credentials
    // (scripts/decode_diagnostic_report.py).
    match /diagnosticReports/{reportId} {
      allow create: if reportId.matches('YD-[2-9A-HJKMNP-Z]{4}-[2-9A-HJKMNP-Z]{4}')
        && request.resource.data.keys().hasOnly([
          "reportId", "createdAt", "appVersion", "build", "osVersion", "device", "locale",
          "installId", "scale", "note", "payload", "payloadBytes", "payloadEncoding",
          "keptEntries", "totalEntries"
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.payload is bytes
        && request.resource.data.payload.size() <= 900000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000
        && request.resource.data.scale is string
        && request.resource.data.scale.size() <= 1000;
      allow read, update, delete: if false;
    }

    // 回饋中心 (`FeedbackService`). No sign-in: each install keeps a random 43-character
    // inbox key in iCloud Keychain, and knowing the key is what grants access to the
    // inbox, as with an unguessable link. Nothing above the inbox is listable and there
    // is no collection-group rule, so a client cannot enumerate other inboxes.
    //
    // The developer side — thread numbers, AI 助手 and developer replies, every status
    // except the two below — is written with admin credentials (Cloud Functions
    // `onFeedbackThreadCreated`, `functions/tools/feedback.ts`). A client may only:
    //   - open a thread together with its first message (status `received`);
    //   - add its own messages and move the thread summary along with them;
    //   - mark the thread read, mark it solved (`done`), or answer a `needsInfo`
    //     request, which puts the thread back in the queue (`queued`).
    // Keep the field lists in step with `FeedbackFirestoreSchema` in the app;
    // `FeedbackFirestoreSchemaTests` reads this file to check that.
    match /feedbackInboxes/{inboxId}/threads/{threadId} {
      function validInbox() {
        return inboxId.matches('[A-Za-z0-9_-]{43}');
      }

      function boundedString(value, limit) {
        return value is string && value.size() <= limit;
      }

      allow get, list: if validInbox();

      allow create: if validInbox()
        && threadId.matches('[0-9a-f-]{36}')
        && request.resource.data.keys().hasOnly([
          "kind", "title", "status", "createdAt", "updatedAt", "lastMessageAt",
          "lastMessagePreview", "lastMessageAuthor", "userLastReadAt", "appVersion", "build",
          "osVersion", "device", "locale", "installId", "diagnosticReportId", "deviceInfo"
        ])
        && request.resource.data.kind in ["bug", "suggestion"]
        && request.resource.data.status == "received"
        && request.resource.data.lastMessageAuthor == "user"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.userLastReadAt == request.time
        && boundedString(request.resource.data.title, 200)
        && boundedString(request.resource.data.lastMessagePreview, 300)
        && boundedString(request.resource.data.diagnosticReportId, 20)
        && request.resource.data.deviceInfo is map
        && request.resource.data.deviceInfo.size() <= 20;

      allow update: if validInbox()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "userLastReadAt", "status", "updatedAt", "lastMessageAt", "lastMessagePreview",
          "lastMessageAuthor"
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
          || request.resource.data.status == "done"
          || (resource.data.status == "needsInfo" && request.resource.data.status == "queued"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastMessageAuthor"])
          || request.resource.data.lastMessageAuthor == "user")
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastMessagePreview"])
          || boundedString(request.resource.data.lastMessagePreview, 300))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["userLastReadAt"])
          || request.resource.data.userLastReadAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"])
          || request.resource.data.updatedAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastMessageAt"])
          || request.resource.data.lastMessageAt == request.time);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if validInbox();

        allow create: if validInbox()
          && messageId.matches('[0-9a-f-]{36}')
          && request.resource.data.keys().hasOnly(["author", "text", "attachments", "createdAt"])
          && request.resource.data.author == "user"
          && request.resource.data.createdAt == request.time
          && boundedString(request.resource.data.text, 5000)
          && request.resource.data.attachments is list
          && request.resource.data.attachments.size() <= 5;

        allow update, delete: if false;
      }
    }
  }
}
