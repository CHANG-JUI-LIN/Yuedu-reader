        "美国",
        "原创",
        "系列",
        "连载中",
        "已完结",
        "完结",
        "网络小说",
        "画集"
      ],
      "store": [
        {
          "layout": "heroCards",
          "params": {
            "sort": "heat"
          }
        },
        {
          "layout": "heroGrid",
          "params": {
            "sort": "rank"
          }
        },
        {
          "layout": "groupedShelves",
          "shelves": [
            {
              "params": {
                "tag": "恋爱"
              }
            },
            {
              "params": {
                "tag": "奇幻"
              }
            },
            {
              "params": {
                "tag": "热血"
              }
            },
            {
              "params": {
                "tag": "搞笑"
              }
            },
            {
              "params": {
