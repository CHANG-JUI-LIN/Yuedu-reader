              }
            },
            {
              "params": {
                "tag": "科幻"
              }
            },
            {
              "params": {
                "tag": "校园"
              }
            },
            {
              "params": {
                "tag": "运动"
              }
            },
            {
              "params": {
                "tag": "日常"
              }
            },
            {
              "params": {
                "tag": "百合"
              }
            }
          ]
        }
      ]
    }
  ],
  "search": {
    "request": {
      "url": "https://api.bgm.tv/v0/search/subjects?limit=20",
      "method": "POST",
      "body": "{\"keyword\":\"{{keyword}}\",\"sort\":\"match\",\"filter\":{\"type\":[1],\"nsfw\":false}}",
      "headers": {
        "User-Agent": "yuedureader/Yuedu (iOS) (+https://yuedureader.com/support)",
        "Content-Type": "application/json"
      },
      "bodyEncoding": "json"
    },
    "list": {
      "items": "$.data[*]",
      "title": "$.name_cn||$.name",
