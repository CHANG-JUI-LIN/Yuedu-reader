{
  "id": "bangumi",
  "title": "Bangumi 番組計劃",
  "description": "Bangumi（bgm.tv）的漫畫與小說排行和搜尋。書架上缺簡介或分類的書，會把書名送到 Bangumi 查詢。",
  "author": "閱讀",
  "site": "https://bgm.tv",
  "version": "1.1",
  "requiredVersion": "3.0.2",
  "hosts": [
    "api.bgm.tv",
    "lain.bgm.tv"
  ],
  "rateLimit": "1/1000",
  "localizations": {
