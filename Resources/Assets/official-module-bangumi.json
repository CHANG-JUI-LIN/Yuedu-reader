        {
          "name": "sort",
          "title": "排序",
          "type": "enumeration",
          "value": "heat",
          "enumOptions": [
            {
              "title": "熱門",
              "value": "heat"
            },
            {
              "title": "高分",
              "value": "rank"
            }
          ]
        },
        {
          "name": "offset",
          "type": "offset"
        }
      ],
      "request": {
        "url": "https://api.bgm.tv/v0/search/subjects?limit=20&offset={{offset}}",
        "method": "POST",
        "bodyEncoding": "json",
        "body": "{\"keyword\":\"\",\"sort\":\"{{sort}}\",\"filter\":{\"type\":[1],\"tag\":[\"{{tag}}\"],\"meta_tags\":[\"漫画\"],\"rank\":[\">0\"],\"nsfw\":false}}",
        "headers": {
          "User-Agent": "yuedureader/Yuedu (iOS) (+https://yuedureader.com/support)",
          "Content-Type": "application/json"
        }
      },
      "list": {
        "items": "$.data[*]",
        "title": "$.name_cn||$.name",
        "author": "$.infobox[?(@.key=='原作')].value||$.infobox[?(@.key=='作者')].value",
        "cover": "$.images.common||$.images.large",
        "intro": "$.summary",
        "url": "https://bgm.tv/subject/{{$.id}}",
        "aliases": "$.name&&$.infobox[?(@.key=='别名')].value[*].v",
        "tags": "$.tags[*].name",
        "publisher": "$.infobox[?(@.key=='出版社')].value"
      },
      "excludeTags": [
        "漫画",
