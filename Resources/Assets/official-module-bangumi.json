        "画集"
      ]
    },
    {
      "id": "comics",
      "title": "漫畫與圖畫小說",
      "cacheDuration": 86400,
      "contentKind": "comic",
      "params": [
        {
          "name": "tag",
          "title": "標籤",
          "type": "enumeration",
          "value": "漫画",
          "enumOptions": [
            {
              "title": "全部",
              "value": "漫画"
            },
            {
              "title": "戀愛",
              "value": "恋爱"
            },
            {
              "title": "奇幻",
