{
  "id": "trends",
  "title": "趨勢",
  "description": "依維基百科瀏覽量排出的熱門小說、完結作品和經典名著，每天更新；地區預設跟隨「中繼資料語言偏好推薦」。",
  "author": "Yuedu",
  "site": "https://yuedureader.com/",
  "version": "1.0",
  "requiredVersion": "3.0",
  "hosts": [
    "gateway.yuedureader.com",
    "upload.wikimedia.org",
    "thumb.wikimedia.org",
    "lain.bgm.tv"
  ],
  "attribution": {
    "text": "Wikipedia, Wikidata (CC BY-SA 4.0), Bangumi. Covers © their respective owners.",
    "url": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "modules": [
    {
      "id": "today",
      "title": "今日熱門",
      "cacheDuration": 21600,
      "params": [
        {
          "name": "region",
          "title": "地區",
          "type": "enumeration",
          "followsLanguage": true,
          "value": "en",
          "enumOptions": [
            {
              "title": "華語（繁）",
              "value": "zh-Hant"
            },
            {
              "title": "華語（簡）",
              "value": "zh-Hans"
            },
            {
              "title": "日本",
              "value": "ja"
            },
            {
              "title": "英語",
              "value": "en"
            }
          ]
        }
      ],
      "request": {
        "url": "https://gateway.yuedureader.com/trends/v1/{{region}}/today.json",
        "headers": {
          "User-Agent": "yuedureader/Yuedu (iOS) (+https://yuedureader.com/support)"
        }
      },
      "list": {
        "items": "$.works[*]",
        "title": "$.title",
        "author": "$.author",
        "cover": "$.cover",
        "intro": "$.intro",
        "url": "$.url",
        "aliases": "$.aliases",
        "series": "$.series"
      }
    },
